# Public search settings. CI injects the same names from GitHub Actions secrets.
# Leave the search key empty locally to use the fallback in docusaurus.config.js.
ALGOLIA_APP_ID=1VU781LYTV
ALGOLIA_INDEX_NAME=accessories_stereo_camera_doc
ALGOLIA_SEARCH_API_KEY=
# Admin / Write API Key for reindexing only. Never commit the real value.
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SITE_URL=https://developer.d-robotics.cc/accessories_stereo_camera_doc
ALGOLIA_NO_PROXY=1
# Optional sitemap override when the public CDN does not expose sitemap.xml:
